<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GravityMaze</RootNamespace>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../GravityMaze/Engine/GameEngine.vb" Link="Engine/GameEngine.vb" />
    <Compile Include="../../GravityMaze/Engine/GameState.vb" Link="Engine/GameState.vb" />
    <Compile Include="../../GravityMaze/Levels/MazeDefinition.vb" Link="Levels/MazeDefinition.vb" />
    <Content Include="../../GravityMaze/Mazes/Level1.txt" Link="Mazes/Level1.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
