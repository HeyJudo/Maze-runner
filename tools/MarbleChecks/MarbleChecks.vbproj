<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GravityMaze</RootNamespace>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../GravityMaze/Rendering/MarbleMotion.vb" Link="MarbleMotion.vb" />
    <Compile Include="../../GravityMaze/Rendering/MarbleMaterial.vb" Link="MarbleMaterial.vb" />
    <Compile Include="../../GravityMaze/Rendering/BoardTilt.vb" Link="BoardTilt.vb" />
    <Compile Include="../../GravityMaze/Rendering/BoardProjection.vb" Link="BoardProjection.vb" />
    <Compile Include="../../GravityMaze/Engine/*.vb" Link="Engine/%(Filename)%(Extension)" />
    <Compile Include="../../GravityMaze/Levels/MazeDefinition.vb" Link="MazeDefinition.vb" />
  </ItemGroup>
</Project>
