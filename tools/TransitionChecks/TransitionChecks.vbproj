<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GravityMaze</RootNamespace>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../GravityMaze/Engine/*.vb" Link="Engine/%(Filename)%(Extension)" />
    <Compile Include="../../GravityMaze/Levels/*.vb" Link="Levels/%(Filename)%(Extension)" />
    <Compile Include="../../GravityMaze/Data/ScoreManager.vb" Link="ScoreManager.vb" />
    <Compile Include="../../GravityMaze/Input/ITiltInput.vb" Link="ITiltInput.vb" />
    <Compile Include="../../GravityMaze/Input/InputManager.vb" Link="InputManager.vb" />
    <Compile Include="../../GravityMaze/UI/Screens/GameShell.vb" Link="GameShell.vb" />
    <Compile Include="../../GravityMaze/UI/Screens/MenuList.vb" Link="MenuList.vb" />
    <Compile Include="../../GravityMaze/UI/Screens/AttractPilot.vb" Link="AttractPilot.vb" />
    <Compile Include="../../GravityMaze/Rendering/BoardCamera.vb" Link="BoardCamera.vb" />
    <Compile Include="../../GravityMaze/Rendering/BoardProjection.vb" Link="BoardProjection.vb" />
    <Compile Include="../../GravityMaze/Rendering/BoardTilt.vb" Link="BoardTilt.vb" />
    <Compile Include="../../GravityMaze/Rendering/GoalDropTransition.vb" Link="GoalDropTransition.vb" />
  </ItemGroup>
</Project>
